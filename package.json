{
  "name": "carovita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Budgeting e previsione del costo della vita in Italia: confronta profili di spesa e scopri quanto puoi risparmiare nel lungo periodo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:refresh": "tsx scripts/fetch-data.ts",
    "backtest": "tsx scripts/run-backtest.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
